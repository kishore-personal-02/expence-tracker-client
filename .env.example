# ================= Expense Tracker — Client environment =================
# Copy this file to client/.env (development only; for production use
# env vars on the build host). Only VITE_* variables are exposed to the app.

# API base URL the browser calls. Defaults to /api — same origin in a
# single-server deployment, or Vite-dev-proxied to the backend locally.
# Point it at your deployed API with a full URL if they are separate hosts.
VITE_API_URL=/api

# Base path the built app is served from (default /). Use /expense-tracker/
# for a sub-path deployment AND set CLIENT_BASE to the same value on the server.
VITE_BASE=/

# Development ONLY (not exposed to the app): where the Vite dev server
# forwards API requests. Keep in sync with the backend PORT/API_MOUNT.
DEV_API_TARGET=http://localhost:5000